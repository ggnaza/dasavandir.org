# Staging environment — points to dasavandir-staging Supabase project
# Copy these values into Vercel → Project → Settings → Environment Variables
# Set environment to "Preview" and git branch to "staging"

NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Use same OpenAI key or a separate staging key
OPENAI_API_KEY=PASTE_OPENAI_KEY_HERE

# Google OAuth — create a separate OAuth client for staging
# or reuse prod and add staging callback URL to allowed redirects
GOOGLE_CLIENT_ID=PASTE_HERE
GOOGLE_CLIENT_SECRET=PASTE_HERE
GOOGLE_REDIRECT_URI=https://staging.dasavandir.org/api/auth/google/callback
GOOGLE_API_KEY=PASTE_HERE

# Mandrill — use same or create a separate staging sender
MANDRILL_API_KEY=PASTE_HERE
MANDRILL_FROM_EMAIL=staging@dasavandir.org

# Staging site URL
NEXT_PUBLIC_SITE_URL=https://staging.dasavandir.org

# Turnstile (Cloudflare) — use test keys for staging
# Test site key (always passes): 1x00000000000000000000AA
# Test secret key (always passes): 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
